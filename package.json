{
  "name": "krillionbot",
  "version": "0.3.7",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:extension": "npm run build && node dist/scripts/build-extension.js",
    "test:browser": "npm run build:extension && node dist/scripts/serve-test.js",
    "test": "npm run build && node --test dist/tests",
    "test:llm": "npm run build && node --test dist/tests/llm.test.js dist/tests/background.test.js dist/tests/retry.test.js",
    "test:controller": "npm run build && node --test dist/tests/extension.test.js",
    "seed:update": "npm run build && node dist/scripts/update-seed.js",
    "seed:packs": "npm run build && node dist/scripts/update-packs.js",
    "seed:merge": "npm run build && node dist/scripts/merge-seed.js",
    "seed:verify": "npm run build && node dist/scripts/verify-seed.js",
    "lookup": "npm run build && node dist/scripts/lookup.js"
  },
  "dependencies": {
    "cheerio": "1.0.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.280",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^20.0.0",
    "esbuild": "^0.25.12",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.0"
  }
}
